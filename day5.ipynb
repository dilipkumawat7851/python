   "source": [
    "#write a function to print factorial of 'n'\n",
    "#n!= 1*2*3*4........*n\n",
    "\n",
    "# n = int(input(\"Enter number:\"))\n",
    "\n",
    "def cal_factorial(n):\n",
    "    fact = 1\n",
    "    for i in range(1,n+1):\n",
    "        fact *= i\n",
    "        \n",
    "    return fact\n",
    "\n",
    "n = int(input(\"Enter number:\"))\n",
    "print(cal_factorial(n))\n",
    "\n"
   ]
